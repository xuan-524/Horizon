{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.2,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "ai-commentary"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "ai-sdk"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "anthropic-sdk-python",
        "enabled": true,
        "category": "ai-sdk"
      },
      {
        "type": "repo_releases",
        "owner": "googleapis",
        "repo": "python-genai",
        "enabled": true,
        "category": "ai-sdk"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "ai-open-source"
      },
      {
        "type": "repo_releases",
        "owner": "ollama",
        "repo": "ollama",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "ai-open-source"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 100,
      "category": "ai-community"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-labs"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-labs"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-open-source"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-commentary"
      },
      {
        "name": "MIT Technology Review AI",
        "url": "https://www.technologyreview.com/topic/artificial-intelligence/feed",
        "enabled": true,
        "category": "ai-industry"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "category": "ai-research"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 40,
          "category": "ai-open-source"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5,
      "category": "ai-commentary"
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": ["ai", "llm", "agent", "model", "inference"],
      "min_stars": 30,
      "max_items": 20,
      "category": "ai-open-source"
    },
    "gdelt": {
      "enabled": false,
      "query": "artificial intelligence",
      "mode": "ArtList",
      "max_records": 50,
      "timespan": "24h",
      "language": null,
      "country": null,
      "category": "ai-industry"
    },
    "google_news": {
      "enabled": true,
      "query": "人工智能 OR 大模型 OR 生成式AI",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 30,
      "category": "ai-industry"
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "max_items": 18,
    "category_groups": {
      "frontier": {
        "name": "模型与研究",
        "limit": 6,
        "categories": ["ai-labs", "ai-research"]
      },
      "tools": {
        "name": "工具与开源",
        "limit": 6,
        "categories": ["ai-tools", "ai-sdk", "ai-open-source"]
      },
      "industry": {
        "name": "行业与商业",
        "limit": 4,
        "categories": ["ai-industry"]
      },
      "community": {
        "name": "社区观点",
        "limit": 4,
        "categories": ["ai-community", "ai-commentary"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "request_body": {},
    "headers": ""
  }
}
